# PixelDesk Backend Environment Configuration
# Copy this file to .env for local development

# Application Environment: 'development' | 'production' | 'testing'
APP_ENV=development

# API Prefix
API_V1_PREFIX=/api/v1

# PostgreSQL Async Database Connection String (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pixeldesk_dev

# JWT Secret for token signing (Must be 32+ characters in production)
JWT_SECRET=replace_with_a_secure_random_secret_in_production_min_32_chars

# Allowed CORS Origins (comma-separated for multiple origins)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
